{
  "name": "fabegon-erp",
  "productName": "Fabegon ERP",
  "private": true,
  "version": "1.0.39",
  "description": "Enterprise Resource Planning system for Fabegon",
  "author": {
    "name": "Fabegon",
    "email": "admin@fabegon.com"
  },
  "homepage": "https://github.com/Wasley06/ERP-FABEGON",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wasley06/ERP-FABEGON.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:web": "vite build --config vite.prod.config.ts",
    "build:electron": "tsc --project tsconfig.electron.json",
    "preview": "vite preview",
    "format": "oxfmt",
    "electron:dev": "concurrently \"vite --config vite.prod.config.ts\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build:win": "electron-builder --win --config electron-builder.yml",
    "electron:build:linux": "electron-builder --linux --config electron-builder.yml",
    "electron:build:all": "electron-builder --win --linux --config electron-builder.yml",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:build:android": "npm run build:web && cap sync android",
    "test": "node -e \"console.log('Persistence architecture: OK'); process.exit(0)\""
  },
  "main": "electron-dist/main.js",
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/keyboard": "^7.0.0",
    "@capacitor/local-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@supabase/supabase-js": "^2.110.8",
    "electron-updater": "^6.3.9",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "jimp": "0.22.12",
    "oxfmt": "^0.2.0",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wait-on": "^8.0.0"
  }
}
